FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

factor  0.85;

boundaryField
{

    walls 
    {
        type            noSlip;
    }

    volume 
    {
        type            zeroGradient;
    }

    inlet 
    {
        type            fixedValue;
        value           uniform (0 -0.2 0);
    }

    fan1
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-4.39 * $factor");
    }

    fan2
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-5.18 * $factor");
    }

    fan3
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-5.17 * $factor");
    }

    fan4
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-4.63 * $factor");
    }

    fan5
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-4.57 * $factor");
    }

    fan6
    {
        type            fixedValue;
        value           uniform (0 0 #calc "-5.06 * $factor");
    }

    outlet 
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
}

