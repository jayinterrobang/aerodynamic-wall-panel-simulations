FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    walls 
    {
        type            noSlip;
    }

    volume 
    {
        type            noSlip;
    }

    inlet 
    {
        type            fixedValue;
        value           uniform (0 -0.2556 0);
    }

    fan1
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate        constant 0.8620;
        radialVelocity  constant 0.7569;
        omega           300;
        
        value           uniform (0 0 0);
    }

    fan2
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate        constant 1.0170;
        radialVelocity  constant 0.8930;
        omega           300;
        
        value           uniform (0 0 0);
    }

    fan3
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate  constant 1.0171;
        radialVelocity  constant 0.8930;   
        omega           300;
        
        value           uniform (0 0 0);
    }

    fan4
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate  constant 0.9091;
        radialVelocity  constant 0.7983;   
        omega           300;
        
        value           uniform (0 0 0);
    }

    fan5
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate  constant 0.9873;
        radialVelocity  constant 0.8669;   
        omega           300;
        
        value           uniform (0 0 0);
    }

    fan6
    {
        type            swirlFlowRateInletVelocity;
        volumetricFlowRate  constant 0.9935;
        radialVelocity  constant 0.8724;   
        omega           300;
        
        value           uniform (0 0 0);
    }

    outlet 
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
}

