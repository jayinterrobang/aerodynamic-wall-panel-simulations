    inlet 
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    outlet 
    {
        type patch;
        faces
        (
            (0 1 5 4)
        );
    }
    walls 
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (2 6 5 1)
            (4 5 6 7)
            (0 3 2 1)
        );
    }
    fan1
    {
        type patch;
        faces
        (
            (8 9 10 11)
        );
    }

