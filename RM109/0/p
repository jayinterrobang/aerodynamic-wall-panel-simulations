{
    outlet 
    {
        type            fixedValue;
        value           uniform 0;
    }

    inlet 
    {
        type            zeroGradient;
    }

    room 
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }

    fan1 
    {
        type            zeroGradient;
    }

    fan2 
    {
        type            zeroGradient;
    }

    fan3 
    {
        type            zeroGradient;
    }

    fan4 
    {
        type            zeroGradient;
    }

    fan5 
    {
        type            zeroGradient;
    }

    fan6 
    {
        type            zeroGradient;
    }

    fan7 
    {
        type            zeroGradient;
    }

    fan8 
    {
        type            zeroGradient;
    }
}

