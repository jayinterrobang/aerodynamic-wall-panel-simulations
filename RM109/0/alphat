FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet 
    {
        type            zeroGradient;
    }
    left 
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }
    fan1 
    {
        type            zeroGradient;
    }
    fan2 
    {
        type            zeroGradient;
    }fan3
    {
        type            zeroGradient;
    }fan4 
    {
        type            zeroGradient;
    }fan5 
    {
        type            zeroGradient;
    }fan6 
    {
        type            zeroGradient;
    }fan7 
    {
        type            zeroGradient;
    }fan8 
    {
        type            zeroGradient;
    }
    room
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
}


