FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

// factor  0.85

boundaryField
{

	// Edit these values to fit
	// - the direction of the wind (you can check with paraview)
	// - the value of the wind vel (this is the thing we recorded)

    inlet 
    {
        type            fixedValue;
        value           uniform (0 -0.7633 0);
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    room 
    {
        type            zeroGradient;
    }

    walls 
    {
        type            noSlip;
    }
    wall 
    {
        type            noSlip;
    }

    fan1
    {
        type            noSlip;
    }

    fan2
    {
        type            fixedValue;
        value           uniform (0 0 -4.8267);
    }

    fan3
    {
        type            fixedValue;
        value           uniform (0 0 -5.9933);
    }

    fan4
    {
        type            fixedValue;
        value           uniform (0 0 -7.1300);
    }

    fan5
    {
        type            fixedValue;
        value           uniform (0 0 -5.1767);
    }

    fan6
    {
        type            fixedValue;
        value           uniform (0 0 -6.1367);
    }

    fan7
    {
        type            noSlip;
    }

    fan8
    {
        type            fixedValue;
        value           uniform (0 0 -5.1200);
    }
}

